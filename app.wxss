page {
  min-height: 100%;
  background: #f3f6f3;
  color: #15251b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: normal;
}

button::after {
  border: 0;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
